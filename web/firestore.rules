rules_version = '2';

// Regras de segurança do Cloud Firestore. São elas que protegem os dados:
// a configuração do Firebase no front-end é pública por natureza.
// Publicar: Console do Firebase > Firestore Database > Regras (colar este
// arquivo) ou "npx firebase-tools deploy --only firestore:rules" em web/.
service cloud.firestore {
  match /databases/{database}/documents {

    // Um documento por pessoa, com id igual ao uid do Authentication.
    match /usuarios/{uid} {
      // Cada usuário lê só o próprio documento.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Cada usuário cria só o próprio documento, com os campos esperados.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && dadosDeCadastroValidos(request.resource.data, uid);

      // O enunciado não prevê edição nem exclusão pelo app.
      allow update, delete: if false;
    }

    function dadosDeCadastroValidos(dados, uid) {
      return dados.keys().hasOnly(['uid', 'nome', 'sobrenome', 'dataNascimento', 'criadoEm'])
        && dados.keys().hasAll(['uid', 'nome', 'sobrenome', 'dataNascimento', 'criadoEm'])
        && dados.uid == uid
        && dados.nome is string && dados.nome.size() > 0 && dados.nome.size() <= 80
        && dados.sobrenome is string && dados.sobrenome.size() > 0 && dados.sobrenome.size() <= 80
        && dados.dataNascimento is string && dados.dataNascimento.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && dados.criadoEm == request.time;
    }
  }
}
