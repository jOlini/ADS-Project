# Copie para web/.env e preencha com o app Web do seu projeto Firebase:
# Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK.
# Esses valores vão para o bundle do navegador, ou seja, são públicos por
# natureza. Quem protege os dados são as regras do Firestore (firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Endereço da API do livro-caixa (contas, categorias e lançamentos). Vazio:
# essas telas ficam desligadas, como na versão publicada no GitHub Pages.
# Local: http://localhost:8081 (a API precisa de CORS_ORIGENS com a origem
# do app no api/.env e de FIREBASE_PROJECT_ID igual ao projeto acima).
# Domínio próprio com a API atrás do mesmo endereço (proxy reverso): /api,
# sem CORS.
VITE_API_URL=

# Caminho onde o build é publicado. Vazio: /ADS-Project/ (GitHub Pages do
# repositório). Domínio próprio ou container: / (o Dockerfile já usa /). Só
# vale para o npm run build e o npm run preview; o npm run dev fica sempre em
# /ADS-Project/, onde o subir-app.py o procura.
VITE_BASE=

# true = usa os emuladores locais do Firebase (Auth na 9099, Firestore na 8088)
# em vez do projeto na nuvem. Subir com: npx firebase-tools emulators:start
# --project demo-pessoal-finance (em web/, exige Java 11+).
VITE_FIREBASE_EMULADOR=false
