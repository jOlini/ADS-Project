# Copie para api/.env e troque os valores. O .env nunca vai para o Git.
# A API lê este arquivo tanto rodando com uvicorn quanto pelo docker compose.
# Num servidor, prefira segredos em arquivo: um arquivo por variável em
# /run/secrets, com o nome em minúsculas (ex.: /run/secrets/jwt_secret).

# "desenvolvimento" (padrão) ou "producao". Em produção a API não sobe com os
# valores de exemplo deste arquivo, com CORS em http:// ou curinga, nem com o
# MongoDB sem senha; e o Swagger e o /openapi.json saem do ar.
AMBIENTE=desenvolvimento

# Só em produção, atrás de um proxy reverso (Caddy, nginx): o IP do proxy, em
# quem o uvicorn confia para ler o IP real de quem chama (X-Forwarded-For).
# Sem isso, o limite de tentativas por endereço vale para todos de uma vez.
# FORWARDED_ALLOW_IPS=192.0.2.10

# No docker compose esta variável é sobrescrita para apontar ao container do banco.
MONGODB_URI=mongodb://localhost:27017/pessoal-finance

# Chave de assinatura do JWT (HS256): no mínimo 32 bytes, aleatória. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-bytes

# Validade do token, em minutos. O logout revoga o token na hora; a validade
# curta limita o tempo de uso de uma cópia vazada que ninguém encerrou.
JWT_EXPIRATION=15

# Origens de navegador autorizadas pelo CORS, separadas por vírgula. O painel em
# /painel/ é da mesma origem e não precisa estar aqui. A área do cliente chama
# o livro-caixa de outra origem: 5173 é o Vite (npm start) e 8080, o container.
CORS_ORIGENS=http://localhost:5173,http://localhost:8080

# ID do projeto Firebase da área do cliente (o mesmo VITE_FIREBASE_PROJECT_ID do
# web/.env; não é segredo). A API só aceita ID tokens emitidos para este projeto.
# Vazio: as rotas do livro-caixa (/espacos) respondem 503; o resto funciona.
FIREBASE_PROJECT_ID=

# E-mails da conta do cliente (confirmação e nova senha) com a marca OliFine.
# Vazio: desligado; as rotas /conta respondem 503 e a área do cliente usa o
# envio do próprio Firebase. Opções: resend, smtp ou pasta (só desenvolvimento:
# grava cada e-mail como .html e .txt em EMAIL_PASTA, para abrir e clicar).
EMAIL_PROVEDOR=
# Endereço da área do cliente, para onde os links dos e-mails levam.
APP_URL=http://localhost:5173/ADS-Project
# Remetente, com o domínio verificado no provedor (SPF e DKIM no DNS).
EMAIL_REMETENTE=OliFine <nao-responda@exemplo.com>
EMAIL_RESPONDER_PARA=
EMAIL_PASTA=emails-enviados
# Chave JSON de uma conta de serviço do Firebase, com o papel "Administrador do
# Firebase Authentication": serve só para gerar os códigos dos links. Guarde
# FORA do repositório (ex.: %USERPROFILE%\.pessoal-finance\firebase-emails.json).
FIREBASE_CONTA_DE_SERVICO=
# Resend (EMAIL_PROVEDOR=resend). Segredo: num servidor, prefira o arquivo
# /run/secrets/resend_api_key.
RESEND_API_KEY=
# Qualquer SMTP (EMAIL_PROVEDOR=smtp): 465 com SSL ou 587 com STARTTLS.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
# Cota diária de e-mails do provedor (Resend grátis: 100 por dia). A telemetria
# avisa no Discord em 80% e em 100%. 0 = sem aviso.
EMAIL_COTA_DIARIA=100

# Alertas e telemetria no Discord: um webhook por canal (Discord > canal >
# Editar canal > Integrações > Webhooks). Vazio = canal desligado. São
# segredos: quem tem o endereço escreve no canal. Num servidor, prefira os
# arquivos /run/secrets/discord_webhook_sistema (e _seguranca, _telemetria).
#   SISTEMA    (#alertas-sistema): erro 500, e-mail que não saiu, API no ar
#   SEGURANCA  (#logs-seguranca): força bruta no login, rajada de 401, abuso dos e-mails
#   TELEMETRIA (#telemetria-custos): resumo de uso e cota de e-mails
# Teste depois de preencher: python subir-app.py alertas
DISCORD_WEBHOOK_SISTEMA=
DISCORD_WEBHOOK_SEGURANCA=
DISCORD_WEBHOOK_TELEMETRIA=
# A cada quantas horas o resumo de uso vai para a telemetria.
TELEMETRIA_INTERVALO_HORAS=24

# Administrador criado na primeira subida, só se o banco estiver vazio.
# Credenciais fictícias: troque antes de usar.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@pessoalfinance.com
ADMIN_SENHA=troque-esta-senha
